{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/forms/**",
              "components/map/**",
              "components/surfaces/**",
              "ui_kits/wander-navigator/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|solid|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, solid, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|mint|lime|liliac|orchid)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'mint' | 'lime' | 'liliac' | 'orchid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|leadingIcon|trailingIcon|full|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, leadingIcon, trailingIcon, full, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|ghost|glow)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'ghost' | 'glow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:raised|glass|sheet|flat)$/]",
        "message": "<Card> variant must be one of 'raised' | 'glass' | 'sheet' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|leadingIcon|trailingIcon|size|full|disabled|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, onChange, placeholder, leadingIcon, trailingIcon, size, full, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Input> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapRoute'] > JSXAttribute > JSXIdentifier[name!=/^(?:points|variant|active|viewBox|dashed|style|key|ref|className|style|children)$/]",
        "message": "<MapRoute> doesn't accept that prop. Declared props: points, variant, active, viewBox, dashed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapRoute'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|preference|alternate)$/]",
        "message": "<MapRoute> variant must be one of 'primary' | 'preference' | 'alternate'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OutingOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|color|key|ref|className|style|children)$/]",
        "message": "<OutingOption> doesn't accept that prop. Declared props: id, label, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='POIChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|meta|selected|alert|icon|onClick|style|key|ref|className|style|children)$/]",
        "message": "<POIChip> doesn't accept that prop. Declared props: label, meta, selected, alert, icon, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadarMist'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|size|intensity|blur|breathe|style|key|ref|className|style|children)$/]",
        "message": "<RadarMist> doesn't accept that prop. Declared props: color, size, intensity, blur, breathe, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
